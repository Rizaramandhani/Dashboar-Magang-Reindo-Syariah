<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Dashboard Magang Reindo Syariah 2026</title>
<style>
:root{--bg:#e8f1f8;--card:#fff;--ink:#12324a;--mute:#5f7a8f;--blue:#1e88d6;--navy:#0d4a7a;--sky:#7cc4f0;--purple:#7e57c2;--line:#d6e4ef;--chip:#eaf4fc;--warn:#e8730c;--ok:#1b9e6b;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e1b27;--card:#16283a;--ink:#e6f1fa;--mute:#93abbd;--blue:#4aa8ee;--navy:#2f7fc0;--sky:#2c6d99;--purple:#a58be0;--line:#26405a;--chip:#1d3550;--warn:#f0944a;--ok:#4cc999}}
:root[data-theme="dark"]{--bg:#0e1b27;--card:#16283a;--ink:#e6f1fa;--mute:#93abbd;--blue:#4aa8ee;--navy:#2f7fc0;--sky:#2c6d99;--purple:#a58be0;--line:#26405a;--chip:#1d3550;--warn:#f0944a;--ok:#4cc999}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;font-size:14px}
.wrap{max-width:1100px;margin:0 auto;padding:16px}
.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:14px}
.card{background:var(--card);border-radius:16px;padding:16px;box-shadow:0 2px 10px rgba(20,70,110,.10);min-width:0}
h1{margin:0;font-size:30px;color:var(--navy);line-height:1.1}
h2{margin:0 0 12px;font-size:15px;font-weight:700}
.sub{color:var(--mute);font-size:12px;margin-top:4px}
.head{grid-column:span 4;display:flex;gap:12px;align-items:center;border:2px solid var(--blue)}
.filters{grid-column:span 8;display:flex;flex-direction:column;gap:10px}
.frow{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.frow b{font-size:13px;margin-right:6px;min-width:96px}
.chip{border:0;background:var(--chip);color:var(--ink);padding:6px 12px;border-radius:999px;cursor:pointer;font:inherit;font-size:12px;border:1px solid var(--line)}
.chip[aria-pressed="true"]{background:var(--blue);color:#fff;border-color:var(--blue)}
.chip:focus-visible,.bar:focus-visible{outline:3px solid var(--purple);outline-offset:2px}
.kpi{grid-column:span 3;text-align:center}
.kpi .n{font-size:44px;font-weight:800;color:var(--blue);line-height:1}
.kpi .l{color:var(--mute);margin-top:6px;font-size:12px}
.c4{grid-column:span 4}.c5{grid-column:span 5}.c6{grid-column:span 6}.c7{grid-column:span 7}.c8{grid-column:span 8}
.donutbox{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.donut{width:120px;height:120px;border-radius:50%;position:relative;flex:none}
.donut::after{content:"";position:absolute;inset:24px;background:var(--card);border-radius:50%}
.donut span{position:absolute;inset:0;display:grid;place-items:center;z-index:1;font-weight:800;font-size:22px}
.legend div{display:flex;align-items:center;gap:8px;margin:5px 0}
.dot{width:11px;height:11px;border-radius:50%;flex:none}
.bar{display:grid;grid-template-columns:128px 1fr 28px;align-items:center;gap:8px;margin:7px 0;cursor:pointer;border-radius:8px;padding:2px 4px;background:none;border:0;width:100%;font:inherit;color:inherit;text-align:left}
.bar:hover{background:var(--chip)}
.bar .t{height:14px;background:var(--chip);border-radius:7px;overflow:hidden}
.bar .t i{display:block;height:100%;background:linear-gradient(90deg,var(--sky),var(--blue));border-radius:7px;transition:width .4s}
.bar.on .t i{background:var(--purple)}
.bar b{text-align:right}
.bar span.nm{font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cols{display:flex;align-items:flex-end;gap:10px;height:170px;padding-top:10px}
.col{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;font-size:11px;color:var(--mute)}
.col i{display:block;width:100%;max-width:46px;background:linear-gradient(var(--blue),var(--sky));border-radius:6px 6px 0 0;min-height:3px;transition:height .4s}
.col b{color:var(--ink);font-size:13px;margin-bottom:3px}
.tablewrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:13px;min-width:560px}
th{text-align:left;color:var(--mute);font-weight:600;padding:8px;border-bottom:2px solid var(--line)}
td{padding:9px 8px;border-bottom:1px solid var(--line)}
.pill{display:inline-block;padding:3px 10px;border-radius:999px;font-weight:700;font-size:12px;color:#fff}
.empty{color:var(--mute);padding:10px 0}
@media (max-width:820px){.head,.filters,.c4,.c5,.c6,.c7,.c8{grid-column:span 12}.kpi{grid-column:span 6}.bar{grid-template-columns:100px 1fr 24px}}
[hidden]{display:none!important}
body{padding-bottom:96px}
.dock{position:fixed;left:0;right:0;bottom:0;padding:8px 16px calc(12px + env(safe-area-inset-bottom,0px));pointer-events:none;z-index:10}
.dock>*{pointer-events:auto;max-width:860px;margin:0 auto 8px}
.chatrow{display:flex;align-items:center;gap:4px;background:var(--card);border:1px solid var(--line);border-radius:999px;padding:6px 14px 6px 8px;box-shadow:0 4px 20px rgba(20,70,110,.20);margin-bottom:0}
.dock.drag .chatrow{outline:3px dashed var(--blue);outline-offset:2px}
.ic{width:38px;height:38px;border-radius:50%;border:0;background:none;color:var(--ink);cursor:pointer;display:grid;place-items:center;font-size:26px;line-height:1;flex:none}
.ic:hover{background:var(--chip)}
.hint{flex:1;text-align:left;border:0;background:none;color:var(--mute);font:inherit;font-size:15px;padding:8px 6px;cursor:pointer}
.ic:focus-visible,.hint:focus-visible,.toast button:focus-visible{outline:3px solid var(--purple);outline-offset:2px}
.toast{background:var(--card);border:1px solid var(--line);border-radius:16px;box-shadow:0 4px 20px rgba(20,70,110,.20);padding:10px 12px;display:flex;align-items:center;gap:10px;font-size:13px;line-height:1.4}
.toast span{flex:1}
.toast.err{border-color:var(--warn)}
.toast button{border:0;background:var(--chip);color:var(--ink);font:inherit;font-size:12px;padding:6px 10px;border-radius:999px;cursor:pointer}
</style>
</head>
<body>
<div class="wrap">
<div class="grid">
  <div class="card head">
    <svg width="54" height="54" viewBox="0 0 54 54" aria-hidden="true"><rect x="4" y="4" width="46" height="46" rx="10" fill="#1e88d6"/><rect x="14" y="28" width="6" height="14" rx="2" fill="#fff"/><rect x="24" y="20" width="6" height="22" rx="2" fill="#fff"/><rect x="34" y="12" width="6" height="30" rx="2" fill="#fff"/></svg>
    <div><h1>Dashboard Magang</h1><div class="sub" id="subt">Reindo Syariah 2026 · data per 8 Okt 2026</div></div>
  </div>
  <div class="card filters">
    <div class="frow"><b>Filter Jenjang</b><span id="fJenjang"></span></div>
    <div class="frow"><b>Filter Divisi</b><span id="fDivisi"></span></div>
  </div>

  <div class="card kpi"><div class="n" id="kTotal">0</div><div class="l">Total Peserta</div></div>
  <div class="card kpi"><div class="n" id="kSoon" style="color:var(--warn)">0</div><div class="l">Berakhir dalam 30 hari</div></div>
  <div class="card kpi"><div class="n" id="kAvg">0</div><div class="l">Rata-rata Sisa Hari</div></div>
  <div class="card kpi"><div class="n" id="kExt" style="color:var(--ok)">0</div><div class="l">Berstatus Perpanjang</div></div>

  <div class="card c4"><h2>Jenjang Pendidikan</h2><div class="donutbox"><div class="donut" id="dJ"><span id="dJt"></span></div><div class="legend" id="lJ"></div></div></div>
  <div class="card c4"><h2>Lama Magang</h2><div class="donutbox"><div class="donut" id="dM"><span id="dMt"></span></div><div class="legend" id="lM"></div></div></div>
  <div class="card c4"><h2>Asal Universitas</h2><div id="bU"></div></div>

  <div class="card c6"><h2>Peserta per Divisi <span class="sub">(klik untuk memfilter)</span></h2><div id="bD"></div></div>
  <div class="card c6"><h2>Peserta per Departemen</h2><div id="bP"></div></div>

  <div class="card c5"><h2>Magang Berakhir per Bulan</h2><div class="cols" id="cols"></div></div>
  <div class="card c7"><h2>Daftar Peserta (urut sisa waktu terdekat)</h2><div class="tablewrap"><table><thead><tr><th>Nama</th><th>Universitas</th><th>Divisi / Departemen</th><th>Berakhir</th><th>Sisa</th></tr></thead><tbody id="tb"></tbody></table></div></div>
</div>
</div>
<div class="dock" id="dock">
  <div class="toast" id="toast" role="status" aria-live="polite" hidden><span id="tmsg"></span><button id="treset" hidden>Kembali ke data awal</button><button id="tclose" aria-label="Tutup pesan">&#10005;</button></div>
  <div class="chatrow">
    <input type="file" id="file" accept=".xlsx,.xls,.csv" hidden>
    <button class="ic" id="plus" aria-label="Tambah file data baru">+</button>
    <button class="hint" id="hint" type="button">Tambahkan file data baru (.xlsx, .xls, .csv)&hellip;</button>
  </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
let REF=new Date(2026,9,8);
const RAW=[
["Choirunnisa Sulistya Azzahra","STIMRA","D3","3 Tahun","RU","Klaim","2027-04-02","s.d lulus D3"],
["Kayla Adisti Sabrina","UNJ","S1","6 Bulan","RJ","PPP","2026-10-13","Perpanjang"],
["Daffa Fauzi Ramadhan","Unpad","S1","6 Bulan","Keuangan","Investasi","2026-11-06","Perpanjang"],
["Ujang Rahmat","STIMRA","D3","6 Bulan","HKMR, SDM & Corsec","Pengadaan & Umum","2026-12-04",""],
["Relfa Athailla Shafiqa Nurdin","UI","S1","3 Bulan","Aktuaria","Admin & Klaim","2026-11-02","Perpanjang"],
["Verisa Anzaeni","UI","S1","3 Bulan","Aktuaria","Aktuaria","2026-10-09","Perpanjang"],
["Riza Ramandhani","Brawijaya","S1","3 Bulan","HKMR, SDM & Corsec","SDM","2027-01-09",""]
];
let D=RAW.map(r=>{const e=new Date(r[6]+"T00:00:00");return{nama:r[0],univ:r[1],jenjang:r[2],masa:r[3],divisi:r[4],dept:r[5],akhir:e,sisa:Math.round((e-REF)/864e5),ket:r[7]}});
const BLN=["Jan","Feb","Mar","Apr","Mei","Jun","Jul","Agu","Sep","Okt","Nov","Des"];
const F={jenjang:"Semua",divisi:"Semua"};
const $=id=>document.getElementById(id);
const uniq=k=>[...new Set(D.map(d=>d[k]))];
const count=(arr,k)=>{const m={};arr.forEach(d=>m[d[k]]=(m[d[k]]||0)+1);return Object.entries(m).sort((a,b)=>b[1]-a[1]||a[0].localeCompare(b[0]))};
const esc=s=>String(s).replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));
const COL=["var(--blue)","var(--purple)","var(--sky)","var(--navy)"];

function chips(el,key,vals){
  el.innerHTML=["Semua",...vals].map(v=>`<button class="chip" aria-pressed="${F[key]===v}" data-k="${key}" data-v="${esc(v)}">${esc(v)}</button>`).join(" ");
}
function setF(k,v){F[k]=(F[k]===v&&v!=="Semua")?"Semua":v;render()}
document.addEventListener("click",e=>{const b=e.target.closest("[data-k]");if(b)setF(b.dataset.k,b.dataset.v)});

function bars(el,arr,key,filterKey){
  const mx=Math.max(1,...arr.map(a=>a[1]));
  el.innerHTML=arr.length?arr.map(([n,c])=>`<button class="bar ${filterKey&&F[filterKey]===n?"on":""}" ${filterKey?`data-k="${filterKey}" data-v="${esc(n)}"`:""}><span class="nm" title="${esc(n)}">${esc(n)}</span><span class="t"><i style="width:${c/mx*100}%"></i></span><b>${c}</b></button>`).join(""):'<div class="empty">Tidak ada data</div>';
}
function donut(dEl,tEl,lEl,arr){
  const tot=arr.reduce((s,a)=>s+a[1],0);let acc=0,g=[];
  arr.forEach(([n,c],i)=>{const s=acc/tot*100;acc+=c;g.push(`${COL[i%4]} ${s}% ${acc/tot*100}%`)});
  dEl.style.background=tot?`conic-gradient(${g.join(",")})`:"var(--chip)";
  tEl.textContent=tot?arr[0][0]+" "+Math.round(arr[0][1]/tot*100)+"%":"–";
  tEl.style.fontSize="15px";
  lEl.innerHTML=arr.map(([n,c],i)=>`<div><span class="dot" style="background:${COL[i%4]}"></span>${esc(n)}: <b>${c}</b> (${Math.round(c/tot*100)}%)</div>`).join("");
}
function render(){
  chips($("fJenjang"),"jenjang",uniq("jenjang").sort());
  chips($("fDivisi"),"divisi",uniq("divisi").sort());
  const S=D.filter(d=>(F.jenjang==="Semua"||d.jenjang===F.jenjang)&&(F.divisi==="Semua"||d.divisi===F.divisi));
  $("kTotal").textContent=S.length;
  $("kSoon").textContent=S.filter(d=>d.sisa<=30).length;
  $("kAvg").textContent=S.length?Math.round(S.reduce((s,d)=>s+d.sisa,0)/S.length):0;
  $("kExt").textContent=S.filter(d=>d.ket==="Perpanjang").length;
  donut($("dJ"),$("dJt"),$("lJ"),count(S,"jenjang"));
  donut($("dM"),$("dMt"),$("lM"),count(S,"masa"));
  bars($("bU"),count(S,"univ"));
  // Divisi chart uses data filtered only by jenjang so all divisions stay clickable
  bars($("bD"),count(D.filter(d=>F.jenjang==="Semua"||d.jenjang===F.jenjang),"divisi"),"divisi","divisi");
  bars($("bP"),count(S,"dept"));
  const m={};S.forEach(d=>{const k=d.akhir.getFullYear()*100+d.akhir.getMonth();m[k]=(m[k]||0)+1});
  const ks=Object.keys(m).sort();const mx=Math.max(1,...Object.values(m));
  $("cols").innerHTML=ks.length?ks.map(k=>`<div class="col"><b>${m[k]}</b><i style="height:${m[k]/mx*100}px"></i><span>${BLN[k%100]} ${String(Math.floor(k/100)).slice(2)}</span></div>`).join(""):'<div class="empty">Tidak ada data</div>';
  $("tb").innerHTML=S.length?[...S].sort((a,b)=>a.sisa-b.sisa).map(d=>{
    const c=d.sisa<=7?"var(--warn)":d.sisa<=30?"#c9a100":"var(--ok)";
    return`<tr><td><b>${esc(d.nama)}</b><div class="sub">${esc(d.jenjang)} · ${esc(d.masa)}${d.ket?" · "+esc(d.ket):""}</div></td><td>${esc(d.univ)}</td><td>${esc(d.divisi)}<div class="sub">${esc(d.dept)}</div></td><td>${d.akhir.getDate()} ${BLN[d.akhir.getMonth()]} ${d.akhir.getFullYear()}</td><td><span class="pill" style="background:${c}">${d.sisa} hari</span></td></tr>`}).join(""):'<tr><td colspan="5" class="empty">Tidak ada peserta untuk filter ini. Pilih "Semua" untuk melihat seluruh data.</td></tr>';
}
render();

/* ===== Tambah file data baru ===== */
const D0=D.slice(),REF0=REF;
const MON={januari:0,februari:1,maret:2,april:3,mei:4,juni:5,juli:6,agustus:7,september:8,oktober:9,november:10,desember:11,jan:0,feb:1,mar:2,apr:3,jun:5,jul:6,agu:7,agt:7,sep:8,okt:9,nov:10,des:11};
function toDate(v){
  if(v instanceof Date&&!isNaN(v))return new Date(v.getFullYear(),v.getMonth(),v.getDate());
  if(typeof v==="number"&&v>20000){const d=new Date(Math.round((v-25569)*864e5));return new Date(d.getUTCFullYear(),d.getUTCMonth(),d.getUTCDate())}
  if(typeof v==="string"){
    const s=v.trim();let m=s.match(/^(\d{1,2})\s+([A-Za-z]+)\s+(\d{4})$/);
    if(m&&MON[m[2].toLowerCase()]!==undefined)return new Date(+m[3],MON[m[2].toLowerCase()],+m[1]);
    m=s.match(/^(\d{4})-(\d{2})-(\d{2})/);if(m)return new Date(+m[1],+m[2]-1,+m[3]);
    m=s.match(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{4})$/);if(m)return new Date(+m[3],+m[2]-1,+m[1]);
  }
  return null;
}
function parseRows(rows){
  let hi=-1;const cm={};
  for(let i=0;i<rows.length;i++){
    const r=(rows[i]||[]).map(x=>String(x==null?"":x).trim().toLowerCase());
    if(r.includes("nama")&&r.includes("divisi")){hi=i;r.forEach((h,j)=>{if(h)cm[h]=j});break}
  }
  if(hi<0)throw new Error("Baris judul kolom tidak ditemukan. Pastikan file memiliki kolom Nama dan Divisi.");
  const miss=["nama","asal universitas","status","masa","akhir","divisi","departemen"].filter(k=>cm[k]===undefined);
  if(miss.length)throw new Error("Kolom yang belum ada di file: "+miss.join(", ")+".");
  let ref=null;
  for(let i=0;i<hi;i++)for(const v of rows[i]||[]){if(typeof v==="number"||v instanceof Date){const d=toDate(v);if(d)ref=d}}
  const g=(r,k)=>String(r[cm[k]]==null?"":r[cm[k]]).trim();
  const out=[];let skip=0;
  for(let i=hi+1;i<rows.length;i++){
    const r=rows[i]||[];const nama=g(r,"nama");
    if(!nama||nama.toLowerCase()==="nama")continue;
    const ak=toDate(r[cm["akhir"]]);
    if(!ak){skip++;continue}
    const st=g(r,"status"),mj=st.match(/\b(S[1-3]|D[1-4])\b/i);
    out.push({nama,univ:g(r,"asal universitas"),jenjang:mj?mj[1].toUpperCase():st,masa:g(r,"masa"),divisi:g(r,"divisi"),dept:g(r,"departemen"),akhir:ak,ket:cm["keterangan"]===undefined?"":g(r,"keterangan")});
  }
  return{out,ref,skip};
}
function setSub(){$("subt").textContent="Reindo Syariah 2026 · data per "+REF.getDate()+" "+BLN[REF.getMonth()]+" "+REF.getFullYear()}
function recalc(){D.forEach(d=>d.sisa=Math.round((d.akhir-REF)/864e5));F.jenjang="Semua";F.divisi="Semua";setSub();render()}
function toast(msg,err,showReset){
  $("tmsg").textContent=msg;$("toast").className="toast"+(err?" err":"");$("treset").hidden=!showReset;$("toast").hidden=false;
}
async function handleFile(f){
  if(!f)return;
  try{
    if(typeof XLSX==="undefined")throw new Error("Pembaca Excel belum termuat. Periksa koneksi internet lalu muat ulang halaman.");
    const wb=XLSX.read(await f.arrayBuffer(),{type:"array"});
    let res=null,err=null;
    for(const n of wb.SheetNames){
      try{const r=parseRows(XLSX.utils.sheet_to_json(wb.Sheets[n],{header:1,raw:true,defval:null}));if(r.out.length){res=r;break}}catch(e){err=e}
    }
    if(!res)throw err||new Error("Tidak ada baris peserta yang bisa dibaca. Pastikan kolom Akhir berisi tanggal.");
    const key=s=>s.toLowerCase().replace(/\s+/g," ");
    const map=new Map(D.map(d=>[key(d.nama),d]));
    let add=0,upd=0;
    res.out.forEach(n=>{const k=key(n.nama);map.has(k)?upd++:add++;map.set(k,n)});
    if(res.ref)REF=res.ref;
    D=[...map.values()];recalc();
    toast(add+" peserta baru ditambahkan, "+upd+" diperbarui dari "+f.name+(res.skip?". "+res.skip+" baris dilewati karena tanggal akhir kosong.":"."),false,true);
  }catch(e){toast((e&&e.message)||"File tidak bisa dibaca.",true,false)}
  $("file").value="";
}
const pick=()=>$("file").click();
$("plus").onclick=pick;$("hint").onclick=pick;
$("file").onchange=e=>handleFile(e.target.files[0]);
$("tclose").onclick=()=>{$("toast").hidden=true};
$("treset").onclick=()=>{D=D0.slice();REF=REF0;recalc();toast("Dashboard dikembalikan ke data awal.",false,false)};
["dragenter","dragover"].forEach(t=>document.addEventListener(t,e=>{e.preventDefault();$("dock").classList.add("drag")}));
["dragleave","drop"].forEach(t=>document.addEventListener(t,e=>{e.preventDefault();$("dock").classList.remove("drag")}));
document.addEventListener("drop",e=>handleFile(e.dataTransfer&&e.dataTransfer.files[0]));
</script>
</body>
</html>
